{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "npm run lint:ts && npm run lint:styles",
    "lint:fix": "npm run lint:ts:fix && npm run lint:styles:fix",
    "lint:ts": "eslint \"src/**/*.ts\"",
    "lint:ts:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:styles": "stylelint \"src/app/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/app/**/*.scss\" --fix",
    "audit:inline": "node scripts/audit-inline-components.mjs",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/cdk": "~21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "~21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@ngrx/signals": "^21.0.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^1.22.5",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/localize": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/angular": "^17.4.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.35",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "^21.3.1",
    "eslint": "^10.1.0",
    "jsdom": "^28.0.0",
    "msw": "^2.12.10",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
